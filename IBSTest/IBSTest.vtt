                <name>LIN_Stop_Check</name>
              </caplfunction>
              <caplinline>
                <title>充电段：记录 LIN 停表时的帧基线与采样基线</title>
                <code>SleepDone = 0;
  HasPrev = 0;
  SampleCnt = 0;
  RxBase = (int)@sysvar::CAB1500_500::CANMsg_RxCounter;
  FramesBase = (int)@sysvar::_Statistics::LIN1::Frames;
  CurPrev_mA = 0.0;
  CurNow_mA = 0.0;
  Elapsed_ms = 0;
  Start_s = (int)(timeNowInt64() / 1000000000);

  write("[SOF][CHG][SLEEP][BASE] rx=%d frames=%d", RxBase, FramesBase);</code>
              </caplinline>
              <while>
                <title>充电段：90 s 内等相邻两个新采样出现 0↔17 mA 跳变</title>
                <compare>
                  <value>
                    <variable>SleepDone</variable>
                  </value>
                  <lt>
                    <const>1</const>
                  </lt>
                </compare>
                <caplinline>
                  <title>充电段：核对 LIN 帧未增长并判定相邻两有效采样的双向跳变</title>
                  <code>int elapsed;
  int framesNow;

  elapsed = ((int)(timeNowInt64() / 1000000000) - Start_s) * 1000;
  Elapsed_ms = elapsed;
  framesNow = (int)@sysvar::_Statistics::LIN1::Frames;
  RxNow = (int)@sysvar::CAB1500_500::CANMsg_RxCounter;

  if (framesNow != FramesBase)
  {
    SleepDone = 1;
    SegOK = 0;
    testStepFail("SOF_CHGSleep", "t=%d ms LIN frames grew after scheduler stop: base=%d now=%d", elapsed, FramesBase, framesNow);
  }
  else if (RxNow != RxBase)
  {
    RxBase = RxNow;
    SampleCnt = SampleCnt + 1;
    CurNow_mA = @sysvar::CAB1500_500::AnalogCurrent;

    if (HasPrev == 1 &amp;&amp;
        CurPrev_mA &gt;= -0.5 &amp;&amp; CurPrev_mA &lt;= 18.0 &amp;&amp;
        CurNow_mA &gt;= -0.5 &amp;&amp; CurNow_mA &lt;= 18.0)
    {
      if ((CurPrev_mA &lt;= 4.0 &amp;&amp; CurNow_mA &gt;= 14.0) ||
          (CurPrev_mA &gt;= 14.0 &amp;&amp; CurNow_mA &lt;= 4.0))
      {
        SleepDone = 1;
        SegOK = 1;
        testStepPass("SOF_CHGSleep", "t=%d ms adjacent 0-to-17 mA jump confirmed: prev=%.3f mA now=%.3f mA samples=%d", elapsed, CurPrev_mA, CurNow_mA, SampleCnt);
      }
    }

    CurPrev_mA = CurNow_mA;
    HasPrev = 1;
  }

  if (SleepDone == 0 &amp;&amp; elapsed &gt;= (int)syspar::IBS::SOF_SleepConfirmWindow_ms)
  {
    SleepDone = 1;
    SegOK = 0;
    testStepFail("SOF_CHGSleep", "t=%d ms no adjacent 0-to-17 mA jump: samples=%d last=%.3f mA frames=%d", elapsed, SampleCnt, CurNow_mA, framesNow);
  }</code>
                </caplinline>
                <wait>
                  <title>充电段：采样间隔</title>
                  <time>
                    <value>
                      <const>1000</const>
                    </value>
                    <unit>ms</unit>
                  </time>
                </wait>
              </while>
              <if>
                <title>充电段：休眠未确认时跳转 Case 尾部收尾</title>
                <compare>
                  <value>
                    <variable>SegOK</variable>
                  </value>
                  <eq>
