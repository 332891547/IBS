        <variables>
          <variable_definition>
            <name>HoldStart_s</name>
            <type>int</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>HoldElapsed_ms</name>
            <type>int</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>ChartEntered</name>
            <type>int</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>ChartViolated</name>
            <type>int</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>SocReached100</name>
            <type>int</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>SocViolated</name>
            <type>int</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>TBatt_C</name>
            <type>float</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>TempSt</name>
            <type>int</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>SocNow</name>
            <type>float</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
        </variables>
        <breakonfail>false</breakonfail>
        <caplfunction>
          <title>配置恒压与充电限流</title>
          <name>PWR_Configure_Check</name>
          <param>
            <type>float</type>
            <value>
              <variable>ChargeVoltage_V</variable>
            </value>
          </param>
          <param>
            <type>float</type>
            <value>
              <variable>ChargeCurrent_A</variable>
            </value>
          </param>
          <param>
            <type>float</type>
            <value>
              <const>0</const>
            </value>
          </param>
        </caplfunction>
        <caplfunction>
          <title>开启充电输出</title>
          <name>PWR_On_Check</name>
        </caplfunction>
        <caplfunction>
          <title>启动 LIN 正常调度并等待新帧</title>
          <name>LIN_OpenNormal_Check</name>
        </caplfunction>
        <awaitvaluematch>
          <title>等待 SOC 严格超过起始门槛</title>
          <timeout>
            <value>
              <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::SOC_StepTimeout_ms|END_OF_OBJECT_ChParScalar|</dbobject>
            </value>
            <unit>ms</unit>
          </timeout>
          <joincondition>
            <enum>any</enum>
          </joincondition>
          <await_nextupdate>
            <bool>true</bool>
          </await_nextupdate>
          <compare>
            <dbobject>DBSignal_BEGIN_OF_OBJECT|1|NodeOrFrameData_BEGIN_OF_OBJECT|1|5|LIN|1|MAXUS_LIN_V3|IBS|END_OF_OBJECT_NodeOrFrameData|FrameData_BEGIN_OF_OBJECT|1|255|255|0|0|Calc_Data_1|53|False|END_OF_OBJECT_FrameData|SOC|1|END_OF_OBJECT_|</dbobject>
            <gt>
              <variable>StartSOC_pct</variable>
            </gt>
          </compare>
        </awaitvaluematch>
        <awaitvaluematch>
          <title>等待 DVM 首次超过计时门槛</title>
          <timeout>
            <value>
              <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::SOC_StepTimeout_ms|END_OF_OBJECT_ChParScalar|</dbobject>
            </value>
            <unit>ms</unit>
          </timeout>
          <joincondition>
            <enum>any</enum>
          </joincondition>
          <await_nextupdate>
            <bool>true</bool>
          </await_nextupdate>
          <compare>
            <dbobject>SysVar_BEGIN_OF_OBJECT|1|DVM_Voltage|N8361|-1|0|END_OF_OBJECT_SysVar|</dbobject>
            <gt>
              <variable>DvmStartVoltage_V</variable>
            </gt>
          </compare>
        </awaitvaluematch>
        <caplinline>
          <title>记录保持起点并清零判据标志</title>
          <code>HoldStart_s = (int)(timeNowInt64() / 1000000000);
HoldElapsed_ms = 0;
ChartEntered = 0;
ChartViolated = 0;
SocReached100 = 0;
SocViolated = 0;
write("[SOC][HOLD][BEGIN] start_s=%d hold_ms=%d sample_ms=%d",
      HoldStart_s, (int)syspar::IBS::SOC_FullChargeHold_ms, (int)syspar::IBS::SOC_HoldSampleInterval_ms);</code>
        </caplinline>
        <while>
          <title>保持段按采样间隔持续监测</title>
          <compare>
            <value>
              <variable>HoldElapsed_ms</variable>
            </value>
            <lt>
              <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::SOC_FullChargeHold_ms|END_OF_OBJECT_ChParScalar|</dbobject>
            </lt>
          </compare>
          <set>
            <title>采样 IBS 温度、温度状态与 SOC</title>
            <in>
              <assignment>
                <sink>
                  <variable>TBatt_C</variable>
                </sink>
                <source>
                  <dbobject>DBSignal_BEGIN_OF_OBJECT|1|NodeOrFrameData_BEGIN_OF_OBJECT|1|5|LIN|1|MAXUS_LIN_V3|IBS|END_OF_OBJECT_NodeOrFrameData|FrameData_BEGIN_OF_OBJECT|1|255|255|0|0|Measured_Data|52|False|END_OF_OBJECT_FrameData|T_BATT|1|END_OF_OBJECT_|</dbobject>
                </source>
              </assignment>
              <assignment>
                <sink>
                  <variable>TempSt</variable>
                </sink>
                <source>
                  <dbobject>DBSignal_BEGIN_OF_OBJECT|1|NodeOrFrameData_BEGIN_OF_OBJECT|1|5|LIN|1|MAXUS_LIN_V3|IBS|END_OF_OBJECT_NodeOrFrameData|FrameData_BEGIN_OF_OBJECT|1|255|255|0|0|Measured_Data|52|False|END_OF_OBJECT_FrameData|Status_Temp|1|END_OF_OBJECT_|</dbobject>
                </source>
              </assignment>
              <assignment>
                <sink>
                  <variable>SocNow</variable>
                </sink>
                <source>
                  <dbobject>DBSignal_BEGIN_OF_OBJECT|1|NodeOrFrameData_BEGIN_OF_OBJECT|1|5|LIN|1|MAXUS_LIN_V3|IBS|END_OF_OBJECT_NodeOrFrameData|FrameData_BEGIN_OF_OBJECT|1|255|255|0|0|Calc_Data_1|53|False|END_OF_OBJECT_FrameData|SOC|1|END_OF_OBJECT_|</dbobject>
                </source>
              </assignment>
            </in>
          </set>
          <caplinline>
            <title>判定温压区域与 SOC 保持并累计保持时长</title>
            <code>float tC;
float vp;
float lo;
float hi;
int st;
int soc;
int ok;

tC  = TBatt_C;
vp  = @sysvar::N8361::DVM_Voltage;
st  = TempSt;
soc = (int)SocNow;
lo  = -1.0;
hi  = -1.0;
ok  = 0;

if (st == 0 &amp;&amp; tC &gt;= (float)syspar::IBS::SOC_ChartTempMin_C &amp;&amp; tC &lt;= (float)syspar::IBS::SOC_ChartTempMax_C)
{
  if (tC &lt;= (float)syspar::IBS::SOC_ChartTempMid1_C)
  {
    lo = (float)syspar::IBS::SOC_ChartLowAt10C_V - (float)syspar::IBS::SOC_ChartLowSlope_V_perC * (tC - (float)syspar::IBS::SOC_ChartTempMin_C);
    hi = (float)syspar::IBS::SOC_ChartHigh_V;
  }
  else if (tC &lt;= (float)syspar::IBS::SOC_ChartTempMid2_C)
  {
    lo = (float)syspar::IBS::SOC_ChartLowFloor_V;
    hi = (float)syspar::IBS::SOC_ChartHigh_V;
  }
  else
  {
    lo = (float)syspar::IBS::SOC_ChartLowFloor_V;
    hi = (float)syspar::IBS::SOC_ChartHigh_V - (float)syspar::IBS::SOC_ChartHighSlope_V_perC * (tC - (float)syspar::IBS::SOC_ChartTempMid2_C);
  }
  if (vp &gt;= lo &amp;&amp; vp &lt;= hi) ok = 1;
}

if (ok == 1 &amp;&amp; ChartEntered == 0)
{
  ChartEntered = 1;
  testStepPass("SOC_Chart", "chart region entered: T=%.1f C, DVM=%.3f V, band=%.3f..%.3f V", tC, vp, lo, hi);
}
if (ChartEntered == 1 &amp;&amp; ok == 0 &amp;&amp; ChartViolated == 0)
{
  ChartViolated = 1;
  testStepFail("SOC_Chart", "left chart region during hold: T=%.1f C, DVM=%.3f V, band=%.3f..%.3f V, temp_status=%d", tC, vp, lo, hi, st);
}
if (soc == 100 &amp;&amp; SocReached100 == 0)
{
  SocReached100 = 1;
  testStepPass("SOC_100", "SOC reached 100: T=%.1f C, DVM=%.3f V", tC, vp);
}
if (SocReached100 == 1 &amp;&amp; soc != 100 &amp;&amp; SocViolated == 0)
{
  SocViolated = 1;
  testStepFail("SOC_100", "SOC dropped to %d after reaching 100", soc);
}

HoldElapsed_ms = ((int)(timeNowInt64() / 1000000000) - HoldStart_s) * 1000;</code>
          </caplinline>
          <wait>
            <title>按采样间隔等待</title>
            <time>
              <value>
                <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::SOC_HoldSampleInterval_ms|END_OF_OBJECT_ChParScalar|</dbobject>
              </value>
              <unit>ms</unit>
            </time>
          </wait>
        </while>
        <caplinline>
          <title>汇总保持段判据结果</title>
          <code>int chartOk;
int socOk;

chartOk = (ChartEntered == 1 &amp;&amp; ChartViolated == 0) ? 1 : 0;
socOk   = (SocReached100 == 1 &amp;&amp; SocViolated == 0) ? 1 : 0;

write("[SOC][HOLD][END] elapsed_ms=%d chart_entered=%d chart_violated=%d soc_reached=%d soc_violated=%d",
      HoldElapsed_ms, ChartEntered, ChartViolated, SocReached100, SocViolated);

if (ChartEntered == 0)
  testStepFail("SOC_HoldChart", "chart region never entered within %d ms hold", HoldElapsed_ms);
if (SocReached100 == 0)
  testStepFail("SOC_HoldSOC", "SOC never reached 100 within %d ms hold", HoldElapsed_ms);
if (chartOk == 1 &amp;&amp; socOk == 1)
  testStepPass("SOC_Hold", "chart region and SOC=100 sustained to hold end, elapsed %d ms", HoldElapsed_ms);</code>
        </caplinline>
        <caplfunction>
          <title>关闭充电输出</title>
          <name>PWR_Off_Check</name>
        </caplfunction>
