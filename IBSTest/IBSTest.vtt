><unit>ms</unit></time></wait><caplinline><title>确认 25 分钟已经经过</title><code>if ((int)(timeNowInt64() / 1000000000) - ChargeStart_s &lt; 1501) testStepFail(&quot;SOCWU_Hold&quot;, &quot;round %d charge hold shorter than 25 min&quot;, RoundIndex);</code></caplinline><caplfunction><title>关输出后核对满充结果</title><name>PWR_Off_Check</name></caplfunction><statecheck><title>关输出成功才执行满充判据</title><expected><compare><value><dbobject>SysVar_BEGIN_OF_OBJECT|1|Set_OutputSts|N8361|-1|0|END_OF_OBJECT_SysVar|</dbobject></value><eq><const>0</const></eq></compare></expected></statecheck><caplfunction><title>停 LIN 后取得新鲜 SOC 结果</title><name>LIN_Stop_Check</name></caplfunction><caplinline><title>记录满充判据前有效帧基线</title><code>CalcBase = (int)@sysvar::LIN::ResetCalc1Counter;</code></caplinline><caplfunction><title>重新开启 LIN 并等待有效帧</title><name>LIN_OpenNormal_Check</name></caplfunction><awaitvaluematch><title>等待满充状态新有效 Calc_Data_1 帧</title><timeout><value><const>5000</const></value><unit>ms</unit></timeout><joincondition><enum>all</enum></joincondition><await_nextupdate><bool>true</bool></await_nextupdate><compare><dbobject>SysVar_BEGIN_OF_OBJECT|1|ResetCalc1Counter|LIN|-1|0|END_OF_OBJECT_SysVar|</dbobject><gt><variable>CalcBase</variable></gt></compare></awaitvaluematch><statecheck><title>本轮新鲜 SOC 等于 100</title><expected><compare><value><dbobject>DBSignal_BEGIN_OF_OBJECT|1|NodeOrFrameData_BEGIN_OF_OBJECT|1|5|LIN|1|MAXUS_LIN_V3|IBS|END_OF_OBJECT_NodeOrFrameData|FrameData_BEGIN_OF_OBJECT|1|255|255|0|0|Calc_Data_1|53|False|END_OF_OBJECT_FrameData|SOC|1|END_OF_OBJECT_|</dbobject></value><eq><const>100</const></eq></compare></expected></statecheck><statecheck><title>本轮新鲜 SOC_STATE 为 2</title><expected><compare><value><dbobject>DBSignal_BEGIN_OF_OBJECT|1|NodeOrFrameData_BEGIN_OF_OBJECT|1|5|LIN|1|MAXUS_LIN_V3|IBS|END_OF_OBJECT_NodeOrFrameData|FrameData_BEGIN_OF_OBJECT|1|255|255|0|0|Calc_Data_1|53|False|END_OF_OBJECT_FrameData|SOC_STATE|1|END_OF_OBJECT_|</dbobject></value><eq><const>2</const></eq></compare></