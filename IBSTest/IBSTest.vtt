      <tc_definition>
        <name>VoltageAccuracyGroup</name>
        <description>单组电压精度：连续 3 次，每次间隔 VA_SampleInterval_ms，同时锁存 IBS 电压 V1（LIN ResetUBattV，取自有效 Measured_Data）与 DVM 电压 V2；逐次计算 E=(V1-V2)/V2*100%，本组最小与最大偏差均须在 ±VA_TolerancePct 内。V2 为 0、采样间无新有效 Measured_Data 帧或无效业务信号增加时判该组无效。</description>
        <tcid>c41d7a02-0004-4b19-a3d5-6e0b7c2f8a44</tcid>
        <parameters>
          <parameter_definition>
            <name>GroupIndex</name>
            <type>float</type>
          </parameter_definition>
        </parameters>
        <variables>
          <variable_definition>
            <name>V1_1</name>
            <type>float</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>V1_2</name>
            <type>float</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>V1_3</name>
            <type>float</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>V2_1</name>
            <type>float</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>V2_2</name>
            <type>float</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>V2_3</name>
            <type>float</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>Cnt0</name>
            <type>int</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>Cnt1</name>
            <type>int</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>Cnt2</name>
            <type>int</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>Cnt3</name>
            <type>int</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>Inv0</name>
            <type>int</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>InvNow</name>
            <type>int</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>Bad</name>
            <type>int</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>E1</name>
            <type>float</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>E2</name>
            <type>float</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>E3</name>
            <type>float</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
        </variables>
        <breakonfail>false</breakonfail>
        <caplinline>
          <title>记录本组起点：有效帧计数与无效计数</title>
          <code>Cnt0 = @sysvar::LIN::ResetMeasuredCounter;
Inv0 = @sysvar::LIN::ResetInvalidCounter;
Bad  = 0;
write("[VA][GROUP][BEGIN] group=%d cnt0=%d inv0=%d t=%I64d",
      (int)GroupIndex, Cnt0, Inv0, timeNowInt64());</code>
        </caplinline>
        <wait>
          <title>第 1 次采样前等待 VA_SampleInterval_ms</title>
          <time>
            <value>
              <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::VA_SampleInterval_ms|END_OF_OBJECT_ChParScalar|</dbobject>
            </value>
            <unit>ms</unit>
          </time>
        </wait>
        <caplinline>
          <title>第 1 次：锁存 IBS 电压与 DVM 电压</title>
          <code>V1_1 = @sysvar::LIN::ResetUBattV;
V2_1 = @sysvar::N8361::DVM_Voltage;
Cnt1 = @sysvar::LIN::ResetMeasuredCounter;
write("[VA][SAMPLE] group=%d n=%d V1=%.4f V2=%.4f cnt=%d",
      (int)GroupIndex, 1, V1_1, V2_1, Cnt1);</code>
        </caplinline>
        <wait>
          <title>第 2 次采样前等待 VA_SampleInterval_ms</title>
          <time>
            <value>
              <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::VA_SampleInterval_ms|END_OF_OBJECT_ChParScalar|</dbobject>
            </value>
            <unit>ms</unit>
          </time>
        </wait>
        <caplinline>
          <title>第 2 次：锁存 IBS 电压与 DVM 电压</title>
          <code>V1_2 = @sysvar::LIN::ResetUBattV;
V2_2 = @sysvar::N8361::DVM_Voltage;
Cnt2 = @sysvar::LIN::ResetMeasuredCounter;
write("[VA][SAMPLE] group=%d n=%d V1=%.4f V2=%.4f cnt=%d",
      (int)GroupIndex, 2, V1_2, V2_2, Cnt2);</code>
        </caplinline>
        <wait>
          <title>第 3 次采样前等待 VA_SampleInterval_ms</title>
          <time>
            <value>
              <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::VA_SampleInterval_ms|END_OF_OBJECT_ChParScalar|</dbobject>
            </value>
            <unit>ms</unit>
          </time>
        </wait>
        <caplinline>
          <title>第 3 次：锁存 IBS 电压与 DVM 电压</title>
          <code>V1_3 = @sysvar::LIN::ResetUBattV;
V2_3 = @sysvar::N8361::DVM_Voltage;
Cnt3 = @sysvar::LIN::ResetMeasuredCounter;
InvNow = @sysvar::LIN::ResetInvalidCounter;
write("[VA][SAMPLE] group=%d n=%d V1=%.4f V2=%.4f cnt=%d",
      (int)GroupIndex, 3, V1_3, V2_3, Cnt3);</code>
        </caplinline>
        <caplinline>
          <title>计算 3 次配对偏差并判定本组 ±VA_TolerancePct</title>
          <code>float tol;
float absE1;
float absE2;
float absE3;
float eMin;
float eMax;
float avgV1;
float avgV2;

tol = (float)syspar::IBS::VA_TolerancePct;
Bad = 0;
eMin = 0.0;
eMax = 0.0;
avgV1 = 0.0;
avgV2 = 0.0;
absE1 = 0.0;
absE2 = 0.0;
absE3 = 0.0;

/* 数据有效性：V2 不得为 0，三次之间必须各有新有效 Measured_Data 帧，无效信号不得增加 */
if (V2_1 == 0.0 || V2_2 == 0.0 || V2_3 == 0.0)
  Bad = 2;
else if (Cnt1 &lt;= Cnt0 || Cnt2 &lt;= Cnt1 || Cnt3 &lt;= Cnt2)
  Bad = 3;
else if (InvNow != Inv0)
  Bad = 4;

if (Bad == 0)
{
  /* 逐次配对相对偏差，% */
  E1 = (V1_1 - V2_1) / V2_1 * 100.0;
  E2 = (V1_2 - V2_2) / V2_2 * 100.0;
  E3 = (V1_3 - V2_3) / V2_3 * 100.0;

  eMin = E1;
  if (E2 &lt; eMin) eMin = E2;
  if (E3 &lt; eMin) eMin = E3;
  eMax = E1;
  if (E2 &gt; eMax) eMax = E2;
  if (E3 &gt; eMax) eMax = E3;

  avgV1 = (V1_1 + V1_2 + V1_3) / 3.0;
  avgV2 = (V2_1 + V2_2 + V2_3) / 3.0;

  write("[VA][GROUP][RESULT] group=%d E1=%.4f E2=%.4f E3=%.4f Emin=%.4f Emax=%.4f avgV1=%.4f avgV2=%.4f tol=%.4f",
        (int)GroupIndex, E1, E2, E3, eMin, eMax, avgV1, avgV2, tol);
}

/* 逐组判定：三项均有效且三次偏差全部落在 +/-tol 内 */
if (Bad == 2)
  testStepFail("VA_GroupInvalid", "group %d: DVM voltage is 0 V, no valid V2", (int)GroupIndex);
else if (Bad == 3)
  testStepFail("VA_GroupInvalid", "group %d: no new valid Measured_Data frame between samples (cnt %d/%d/%d/%d)",
               (int)GroupIndex, Cnt0, Cnt1, Cnt2, Cnt3);
else if (Bad == 4)
  testStepFail("VA_GroupInvalid", "group %d: invalid business signal increased %d -&gt; %d",
               (int)GroupIndex, Inv0, InvNow);
else
{
  absE1 = (E1 &lt; 0.0) ? -E1 : E1;
  absE2 = (E2 &lt; 0.0) ? -E2 : E2;
  absE3 = (E3 &lt; 0.0) ? -E3 : E3;
  if (absE1 &lt;= tol &amp;&amp; absE2 &lt;= tol &amp;&amp; absE3 &lt;= tol)
    testStepPass("VA_GroupPass", "group %d: E1=%.4f%% E2=%.4f%% E3=%.4f%% within +/-%.4f%%",
                 (int)GroupIndex, E1, E2, E3, tol);
  else
    testStepFail("VA_GroupFail", "group %d: E1=%.4f%% E2=%.4f%% E3=%.4f%% exceeds +/-%.4f%%",
                 (int)GroupIndex, E1, E2, E3, tol);
}</code>
        </caplinline>
      </tc_definition>
      <tc_definition>
        <name>SOC_BatteryReadyCheck</name>
        <description>电池供电前检查：输出命令为 0、电池继电器命令为已接入，且 DVM 实测电压落在 SOC_BatteryReadyMin_V..SOC_BatteryReadyMax_V 内。只判命令与读数，不判触点，也不能证明 DVM 采样新鲜度。</description>
        <tcid>4b1f7d20-5c33-4a11-9a01-000000000001</tcid>
        <parameters />
        <breakonfail>true</breakonfail>
        <caplinline>
          <title>判定供电前状态与实测电池电压</title>
          <code>float v;
int bat;
int outSts;
float vMin;
float vMax;

bat    = (int)@sysvar::Power_RelayCrtl::BatteryConnectEquipment;
outSts = (int)@sysvar::N8361::Set_OutputSts;
v      = @sysvar::N8361::DVM_Voltage;
vMin   = (float)syspar::IBS::SOC_BatteryReadyMin_V;
vMax   = (float)syspar::IBS::SOC_BatteryReadyMax_V;

write("[SOC][READY] bat_cmd=%d out_cmd=%d dvm=%.3f V range=%.2f..%.2f V", bat, outSts, v, vMin, vMax);

if (outSts != 0)
  testStepFail("SOC_BatteryReady", "output command is %d, must be 0 before battery supply", outSts);
else if (bat != 1)
  testStepFail("SOC_BatteryReady", "battery relay command is %d, expected 1", bat);
else if (!(v &gt;= vMin &amp;&amp; v &lt;= vMax))
  testStepFail("SOC_BatteryReady", "measured battery voltage %.3f V outside %.2f..%.2f V; do not start charge", v, vMin, vMax);
else
  testStepPass("SOC_BatteryReady", "measured battery voltage %.3f V within %.2f..%.2f V", v, vMin, vMax);</code>
        </caplinline>
