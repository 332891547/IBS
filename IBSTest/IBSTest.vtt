          <title>等待 IBS 报告 SOC 降至放电目标</title>
          <timeout>
            <value>
              <variable>ChargeDischargeTimeout_ms</variable>
            </value>
            <unit>ms</unit>
          </timeout>
          <joincondition>
            <enum>any</enum>
          </joincondition>
          <await_nextupdate>
            <bool>true</bool>
          </await_nextupdate>
          <compare>
            <dbobject>DBSignal_BEGIN_OF_OBJECT|1|NodeOrFrameData_BEGIN_OF_OBJECT|1|5|LIN|1|MAXUS_LIN_V3|IBS|END_OF_OBJECT_NodeOrFrameData|FrameData_BEGIN_OF_OBJECT|1|255|255|0|0|Calc_Data_1|53|False|END_OF_OBJECT_FrameData|SOC|1|END_OF_OBJECT_|</dbobject>
            <le>
              <variable>DischargeTargetSOC_pct</variable>
            </le>
          </compare>
        </awaitvaluematch>
        <caplinline>
          <title>放电 SOC 等待结束</title>
          <code>write("[SOC][DISCHARGE][AWAIT_END] t=%I64d", timeNowInt64());</code>
        </caplinline>
        <set>
          <title>放电目标达成后关闭 N8361 输出</title>
          <in>
            <assignment>
              <sink>
                <dbobject>SysVar_BEGIN_OF_OBJECT|1|Set_OutputSts|N8361|-1|0|END_OF_OBJECT_SysVar|</dbobject>
              </sink>
              <source>
                <const>0</const>
              </source>
            </assignment>
          </in>
        </set>
        <caplfunction>
          <title>停止 LIN 调度</title>
          <name>LIN_Stop_Check</name>
        </caplfunction>
        <statecheck>
          <title>放电结束时 SOC 已降至目标</title>
          <expected>
            <compare>
              <value>
                <dbobject>DBSignal_BEGIN_OF_OBJECT|1|NodeOrFrameData_BEGIN_OF_OBJECT|1|5|LIN|1|MAXUS_LIN_V3|IBS|END_OF_OBJECT_NodeOrFrameData|FrameData_BEGIN_OF_OBJECT|1|255|255|0|0|Calc_Data_1|53|False|END_OF_OBJECT_FrameData|SOC|1|END_OF_OBJECT_|</dbobject>
              </value>
              <le>
                <variable>DischargeTargetSOC_pct</variable>
              </le>
            </compare>
          </expected>
        </statecheck>
      </tc_definition>
      <tc_definition>
        <name>CheckSOCStateUncalibrated</name>
        <description>启动 LIN 正常调度采集新鲜报文后，校验 SOC 处于 0~100 有效区间且 SOC_STATE 为未校准值 0 或 1（本工程 LDF 分别对应偏差高于 15% 与低于 15%），随后停止 LIN 调度。</description>
        <tcid>e129c91f-8661-4df5-a2b6-11ec77363473</tcid>
        <parameters />
        <breakonfail>true</breakonfail>
        <caplfunction>
          <title>启动 LIN 正常调度并等待新帧</title>
          <name>LIN_OpenNormal_Check</name>
        </caplfunction>
        <statecheck>
          <title>SOC 信号有效（0~100%）</title>
          <expected>
            <compare>
              <value>
                <dbobject>DBSignal_BEGIN_OF_OBJECT|1|NodeOrFrameData_BEGIN_OF_OBJECT|1|5|LIN|1|MAXUS_LIN_V3|IBS|END_OF_OBJECT_NodeOrFrameData|FrameData_BEGIN_OF_OBJECT|1|255|255|0|0|Calc_Data_1|53|False|END_OF_OBJECT_FrameData|SOC|1|END_OF_OBJECT_|</dbobject>
              </value>
              <range>
                <fromto>
                  <from>
                    <const>0</const>
                  </from>
                  <to>
                    <const>100</const>
                  </to>
                </fromto>
              </range>
            </compare>
          </expected>
        </statecheck>
        <statecheck>
          <title>SOC_STATE 为未校准（0 或 1）</title>
          <expected>
            <compare>
              <value>
                <dbobject>DBSignal_BEGIN_OF_OBJECT|1|NodeOrFrameData_BEGIN_OF_OBJECT|1|5|LIN|1|MAXUS_LIN_V3|IBS|END_OF_OBJECT_NodeOrFrameData|FrameData_BEGIN_OF_OBJECT|1|255|255|0|0|Calc_Data_1|53|False|END_OF_OBJECT_FrameData|SOC_STATE|1|END_OF_OBJECT_|</dbobject>
              </value>
              <range>
                <fromto>
                  <from>
                    <const>0</const>
                  </from>
                  <to>
                    <const>1</const>
                  </to>
                </fromto>
              </range>
            </compare>
          </expected>
        </statecheck>
        <caplfunction>
          <title>停止 LIN 调度</title>
          <name>LIN_Stop_Check</name>
        </caplfunction>
      </tc_definition>
      <tc_definition>
        <name>CheckSOCStateCalibrated</name>
        <description>启动 LIN 正常调度采集新鲜报文后，校验 SOC 处于 0~100 有效区间且 SOC_STATE 为已校准值 2（本工程 LDF 对应偏差低于 10%），随后停止 LIN 调度。</description>
        <tcid>aa37f1c9-56e0-4535-80f1-eea69af3569a</tcid>
        <parameters />
        <breakonfail>true</breakonfail>
        <caplfunction>
          <title>启动 LIN 正常调度并等待新帧</title>
          <name>LIN_OpenNormal_Check</name>
        </caplfunction>
        <statecheck>
          <title>SOC 信号有效（0~100%）</title>
          <expected>
            <compare>
              <value>
                <dbobject>DBSignal_BEGIN_OF_OBJECT|1|NodeOrFrameData_BEGIN_OF_OBJECT|1|5|LIN|1|MAXUS_LIN_V3|IBS|END_OF_OBJECT_NodeOrFrameData|FrameData_BEGIN_OF_OBJECT|1|255|255|0|0|Calc_Data_1|53|False|END_OF_OBJECT_FrameData|SOC|1|END_OF_OBJECT_|</dbobject>
              </value>
              <range>
                <fromto>
                  <from>
                    <const>0</const>
                  </from>
                  <to>
                    <const>100</const>
                  </to>
                </fromto>
              </range>
            </compare>
          </expected>
        </statecheck>
        <statecheck>
          <title>SOC_STATE 为已校准（2）</title>
          <expected>
            <compare>
              <value>
                <dbobject>DBSignal_BEGIN_OF_OBJECT|1|NodeOrFrameData_BEGIN_OF_OBJECT|1|5|LIN|1|MAXUS_LIN_V3|IBS|END_OF_OBJECT_NodeOrFrameData|FrameData_BEGIN_OF_OBJECT|1|255|255|0|0|Calc_Data_1|53|False|END_OF_OBJECT_FrameData|SOC_STATE|1|END_OF_OBJECT_|</dbobject>
              </value>
              <eq>
                <const>2</const>
              </eq>
            </compare>
          </expected>
        </statecheck>
        <caplfunction>
          <title>停止 LIN 调度</title>
          <name>LIN_Stop_Check</name>
        </caplfunction>
      </tc_definition>
      <tc_definition>
        <name>WaitForSOCRestCalibration</name>
        <description>保持 IBS 供电，按 SOC_PointRest_ms 参数静置，供各档 SOC 静置校准调用。</description>
        <tcid>0639515e-4606-42b6-a8be-be0fd1188862</tcid>
        <parameters />
        <breakonfail>true</breakonfail>
        <caplinline>
          <title>SOC 静置等待开始</title>
          <code>write("[SOC][REST][BEGIN] t=%I64d", timeNowInt64());</code>
        </caplinline>
        <wait>
          <title>按 SOC_PointRest_ms 静置</title>
          <time>
            <value>
              <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::SOC_PointRest_ms|END_OF_OBJECT_ChParScalar|</dbobject>
            </value>
            <unit>ms</unit>
          </time>
        </wait>
        <caplinline>
          <title>SOC 静置等待结束</title>
          <code>write("[SOC][REST][END] t=%I64d", timeNowInt64());</code>
        </caplinline>
      </tc_definition>
    </tc_definitions>
    <function_definitions>
      <function_definition navid="1a4d6e92-73c5-4f08-9b21-5d8e0c7a3f61">
        <name>PHASE_Prepare</name>
        <export>true</export>
        <description>准备段：开日志、停 LIN、关唤醒节点、关输出、继电器切 IDLE</description>
        <parameters>
          <parameter_definition>
            <name>SequenceName</name>
            <type>string</type>
          </parameter_definition>
        </parameters>
        <ttfunction>
          <title>开启本轮 BLF 日志</title>
          <name>StartLog</name>
          <param>
            <type>string</type>
            <value>
              <variable>SequenceName</variable>
            </value>
          </param>
        </ttfunction>
        <caplinline>
          <title>读取准备参数并记录开始</title>
          <code>long linSettleMs;
long relaySettleMs;

linSettleMs   = (long)syspar::IBS::TB_LinStopSettle_ms;
relaySettleMs = (long)syspar::IBS::TB_RelaySettle_ms;
write("[PHASE][PREP][BEGIN] seq=%s lin_settle_ms=%ld relay_settle_ms=%ld",
      SequenceName, linSettleMs, relaySettleMs);</code>
        </caplinline>
        <caplfunction>
          <title>停 LIN 调度</title>
          <name>PHASE_Prep_LinStop</name>
        </caplfunction>
        <caplfunction>
          <title>禁用唤醒节点</title>
          <name>PHASE_Prep_WakeNodeOff</name>
        </caplfunction>
        <caplfunction>
          <title>关闭电源输出</title>
          <name>PHASE_Prep_PowerOff</name>
        </caplfunction>
        <caplfunction>
          <title>请求 IDLE 继电器命令；触点未验证</title>
          <name>PHASE_Prep_RelayIdle</name>
        </caplfunction>
        <caplinline>
          <title>准备完成</title>
          <code>write("[PHASE][PREP][END] seq=%s", SequenceName);</code>
        </caplinline>
      </function_definition>
      <function_definition navid="8b7c2f35-4610-4d9a-a3e7-92c5b1f04e28">
        <name>PHASE_Complete</name>
        <export>true</export>
        <description>收尾段：停 LIN、关输出、等 DVM 回零、继电器切 SAFE、关唤醒节点、停日志</description>
        <parameters />
        <caplfunction>
          <title>初始化收尾结果</title>
          <name>PHASE_Done_Begin</name>
        </caplfunction>
        <caplfunction>
          <title>停 LIN 调度</title>
          <name>PHASE_Done_LinStop</name>
        </caplfunction>
        <caplfunction>
          <title>关闭电源输出</title>
          <name>PHASE_Done_PowerOff</name>
        </caplfunction>
        <caplfunction>
          <title>等待 DVM 回零</title>
          <name>PHASE_Done_WaitZero</name>
        </caplfunction>
        <caplfunction>
          <title>请求 SAFE 继电器命令；触点未验证</title>
          <name>PHASE_Done_RelaySafe</name>
        </caplfunction>
        <caplfunction>
          <title>禁用唤醒节点</title>
          <name>PHASE_Done_WakeNodeOff</name>
        </caplfunction>
        <caplinline>
          <title>收尾完成</title>
          <code>write("[PHASE][DONE][END]");</code>
        </caplinline>
        <ttfunction>
          <title>停止本轮 BLF 日志</title>
          <name>StopLog</name>
        </ttfunction>
        <caplfunction>
          <title>汇总收尾失败</title>
          <name>PHASE_Done_Result</name>
        </caplfunction>
      </function_definition>
      <function_definition navid="2047716e-1449-4ffb-aeb8-79e1ef8e58b6">
        <name>StartLog</name>
        <export>false</export>
        <description>使用序列名开启本轮 BLF 日志</description>
        <parameters>
          <parameter_definition>
            <name>TestCaseName</name>
            <type>string</type>
          </parameter_definition>
        </parameters>
        <caplinline>
          <title>启动 Logging 记录块</title>
          <code>char logPath[260];
stopLogging("Logging");
snprintf(logPath, elcount(logPath),
         "Logging\\%s\\{LocalTime|YYYYMMDD}\\{LocalTime|YYYYMMDD_hhmmss}_{IncTrigger|001}.blf",
         TestCaseName);
setLogFileName("Logging", logPath);
startLogging("Logging");
writeLineEx(0, 1, "[LOG] BLF recording started: %s", logPath);</code>
        </caplinline>
      </function_definition>
      <function_definition navid="6a3ef6d2-b06d-4109-8c24-99d1f5de9032">
        <name>StopLog</name>
        <export>false</export>
        <description>停止本轮 BLF 日志</description>
        <parameters />
        <caplinline>
          <title>停止 Logging 记录块</title>
          <code>stopLogging("Logging");
writeLineEx(0, 1, "[LOG] BLF recording stopped");</code>
        </caplinline>
      </function_definition>
      <function_definition navid="03d96ebf-efe2-40c7-b68e-f8d2c4c49387">
        <name>Restart_IBS</name>
        <export>false</export>
        <description>IBS 断开电源 6 s 后重新上电并等待 1 s；复位后按用户确认预期 SOC_STATE 回到未校准，实际状态由后续 Test Case 判定。</description>
        <parameters />
        <set>
          <title>IBS 断电</title>
          <in>
            <assignment>
              <sink>
                <dbobject>SysVar_BEGIN_OF_OBJECT|1|IBS_PowerCtrl|Power_RelayCrtl|-1|0|END_OF_OBJECT_SysVar|</dbobject>
              </sink>
              <source>
                <const>1</const>
              </source>
            </assignment>
          </in>
        </set>
        <wait>
          <title>保持断电 6 s</title>
          <time>
            <value>
              <const>6000</const>
            </value>
            <unit>ms</unit>
          </time>
        </wait>
        <set>
          <title>IBS 重新上电</title>
          <in>
            <assignment>
              <sink>
                <dbobject>SysVar_BEGIN_OF_OBJECT|1|IBS_PowerCtrl|Power_RelayCrtl|-1|0|END_OF_OBJECT_SysVar|</dbobject>
              </sink>
              <source>
                <const>0</const>
              </source>
            </assignment>
          </in>
        </set>
        <wait>
          <title>等待 1 s</title>
          <time>
            <value>
              <const>1000</const>
            </value>
            <unit>ms</unit>
          </time>
        </wait>
      </function_definition>
    </function_definitions>
  </ttlib>
</ttroot>