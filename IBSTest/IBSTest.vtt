          <title>回升第 5 档：DVM 达 10.5 V ±IGTV_VoltageTolerance_V</title>
          <timeout>
            <value>
              <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::IGTV_VoltageTimeout_ms|END_OF_OBJECT_ChParScalar|</dbobject>
            </value>
            <unit>ms</unit>
          </timeout>
          <joincondition>
            <enum>all</enum>
          </joincondition>
          <await_nextupdate>
            <bool>true</bool>
          </await_nextupdate>
          <compare>
            <dbobject>SysVar_BEGIN_OF_OBJECT|1|DVM_Voltage|N8361|-1|0|END_OF_OBJECT_SysVar|</dbobject>
            <range>
              <based>
                <base>
                  <const>10.5</const>
                </base>
                <down_tolerance>
                  <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::IGTV_VoltageTolerance_V|END_OF_OBJECT_ChParScalar|</dbobject>
                </down_tolerance>
                <up_tolerance>
                  <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::IGTV_VoltageTolerance_V|END_OF_OBJECT_ChParScalar|</dbobject>
                </up_tolerance>
              </based>
            </range>
          </compare>
        </awaitvaluematch>
        <wait>
          <title>回升第 5 档：补足本档时间预算</title>
          <time>
            <value>
              <variable>BandWait_ms</variable>
            </value>
            <unit>ms</unit>
          </time>
        </wait>
        <set>
          <title>回升第 6 档：设定 10.8 V</title>
          <in>
            <assignment>
              <sink>
                <dbobject>SysVar_BEGIN_OF_OBJECT|1|Set_OutPutVoltage|N8361|-1|0|END_OF_OBJECT_SysVar|</dbobject>
              </sink>
              <source>
                <const>10.8</const>
              </source>
            </assignment>
          </in>
        </set>
        <awaitvaluematch>
          <title>回升第 6 档：DVM 达 10.8 V ±IGTV_VoltageTolerance_V</title>
          <timeout>
            <value>
              <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::IGTV_VoltageTimeout_ms|END_OF_OBJECT_ChParScalar|</dbobject>
            </value>
            <unit>ms</unit>
          </timeout>
          <joincondition>
            <enum>all</enum>
          </joincondition>
          <await_nextupdate>
            <bool>true</bool>
          </await_nextupdate>
          <compare>
            <dbobject>SysVar_BEGIN_OF_OBJECT|1|DVM_Voltage|N8361|-1|0|END_OF_OBJECT_SysVar|</dbobject>
            <range>
              <based>
                <base>
                  <const>10.8</const>
                </base>
                <down_tolerance>
                  <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::IGTV_VoltageTolerance_V|END_OF_OBJECT_ChParScalar|</dbobject>
                </down_tolerance>
                <up_tolerance>
                  <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::IGTV_VoltageTolerance_V|END_OF_OBJECT_ChParScalar|</dbobject>
                </up_tolerance>
              </based>
            </range>
          </compare>
        </awaitvaluematch>
        <wait>
          <title>回升第 6 档：补足本档时间预算</title>
          <time>
            <value>
              <variable>BandWait_ms</variable>
            </value>
            <unit>ms</unit>
          </time>
        </wait>
        <caplfunction>
          <title>回升后检查正常通信</title>
          <name>SleepCurrent_Monitor_Check</name>
        </caplfunction>
        <set>
          <title>关闭 N8361 输出</title>
          <in>
            <assignment>
              <sink>
                <dbobject>SysVar_BEGIN_OF_OBJECT|1|Set_OutputSts|N8361|-1|0|END_OF_OBJECT_SysVar|</dbobject>
              </sink>
              <source>
                <const>0</const>
              </source>
            </assignment>
          </in>
        </set>
      </tc_definition>
    </tc_definitions>
    <function_definitions>
      <function_definition navid="1a4d6e92-73c5-4f08-9b21-5d8e0c7a3f61">
        <name>PHASE_Prepare</name>
        <export>true</export>
        <description>准备段：开日志、停 LIN、关唤醒节点、关输出、继电器切 IDLE</description>
        <parameters>
          <parameter_definition>
            <name>SequenceName</name>
            <type>string</type>
          </parameter_definition>
        </parameters>
        <ttfunction>
          <title>开启本轮 BLF 日志</title>
          <name>StartLog</name>
          <param>
            <type>string</type>
            <value>
              <variable>SequenceName</variable>
            </value>
          </param>
        </ttfunction>
        <caplinline>
          <title>读取准备参数并记录开始</title>
          <code>long linSettleMs;
long relaySettleMs;

linSettleMs   = (long)syspar::IBS::TB_LinStopSettle_ms;
relaySettleMs = (long)syspar::IBS::TB_RelaySettle_ms;
write("[PHASE][PREP][BEGIN] seq=%s lin_settle_ms=%ld relay_settle_ms=%ld",
      SequenceName, linSettleMs, relaySettleMs);</code>
        </caplinline>
        <caplfunction>
          <title>停 LIN 调度</title>
          <name>PHASE_Prep_LinStop</name>
        </caplfunction>
        <caplfunction>
          <title>禁用唤醒节点</title>
          <name>PHASE_Prep_WakeNodeOff</name>
        </caplfunction>
        <caplfunction>
          <title>关闭电源输出</title>
          <name>PHASE_Prep_PowerOff</name>
        </caplfunction>
        <caplfunction>
          <title>请求 IDLE 继电器命令；触点未验证</title>
          <name>PHASE_Prep_RelayIdle</name>
        </caplfunction>
        <caplinline>
          <title>准备完成</title>
          <code>write("[PHASE][PREP][END] seq=%s", SequenceName);</code>
        </caplinline>
      </function_definition>
      <function_definition navid="8b7c2f35-4610-4d9a-a3e7-92c5b1f04e28">
        <name>PHASE_Complete</name>
        <export>true</export>
        <description>收尾段：停 LIN、关输出、等 DVM 回零、继电器切 SAFE、关唤醒节点、停日志</description>
        <parameters />
        <caplfunction>
          <title>初始化收尾结果</title>
          <name>PHASE_Done_Begin</name>
        </caplfunction>
        <caplfunction>
          <title>停 LIN 调度</title>
          <name>PHASE_Done_LinStop</name>
        </caplfunction>
        <caplfunction>
          <title>关闭电源输出</title>
          <name>PHASE_Done_PowerOff</name>
        </caplfunction>
        <caplfunction>
          <title>等待 DVM 回零</title>
          <name>PHASE_Done_WaitZero</name>
        </caplfunction>
        <caplfunction>
          <title>请求 SAFE 继电器命令；触点未验证</title>
          <name>PHASE_Done_RelaySafe</name>
        </caplfunction>
        <caplfunction>
          <title>禁用唤醒节点</title>
          <name>PHASE_Done_WakeNodeOff</name>
        </caplfunction>
        <caplinline>
          <title>收尾完成</title>
          <code>write("[PHASE][DONE][END]");</code>
        </caplinline>
        <ttfunction>
          <title>停止本轮 BLF 日志</title>
          <name>StopLog</name>
        </ttfunction>
        <caplfunction>
          <title>汇总收尾失败</title>
          <name>PHASE_Done_Result</name>
        </caplfunction>
      </function_definition>
      <function_definition navid="2047716e-1449-4ffb-aeb8-79e1ef8e58b6">
        <name>StartLog</name>
        <export>false</export>
        <description>使用序列名开启本轮 BLF 日志</description>
        <parameters>
          <parameter_definition>
            <name>TestCaseName</name>
            <type>string</type>
          </parameter_definition>
        </parameters>
        <caplinline>
          <title>启动 Logging 记录块</title>
          <code>char logPath[260];
stopLogging("Logging");
snprintf(logPath, elcount(logPath),
         "Logging\\%s\\{LocalTime|YYYYMMDD}\\{LocalTime|YYYYMMDD_hhmmss}_{IncTrigger|001}.blf",
         TestCaseName);
setLogFileName("Logging", logPath);
startLogging("Logging");
writeLineEx(0, 1, "[LOG] BLF recording started: %s", logPath);</code>
        </caplinline>
      </function_definition>
      <function_definition navid="6a3ef6d2-b06d-4109-8c24-99d1f5de9032">
        <name>StopLog</name>
        <export>false</export>
        <description>停止本轮 BLF 日志</description>
        <parameters />
        <caplinline>
          <title>停止 Logging 记录块</title>
          <code>stopLogging("Logging");
writeLineEx(0, 1, "[LOG] BLF recording stopped");</code>
        </caplinline>
      </function_definition>
      <function_definition navid="03d96ebf-efe2-40c7-b68e-f8d2c4c49387">
        <name>Restart_IBS</name>
        <export>false</export>
        <description>IBS 断电 OffTime_ms 后重新上电并等待 1 s；断电时长由调用方传入，其他用例仍显式传 6000 ms 保持原行为；复位后预期 SOC_STATE 回到未校准，实际状态由后续 Test Case 判定。</description>
        <parameters>
          <parameter_definition>
            <name>OffTime_ms</name>
            <type>int</type>
          </parameter_definition>
        </parameters>
        <set>
          <title>IBS 断电</title>
          <in>
            <assignment>
              <sink>
                <dbobject>SysVar_BEGIN_OF_OBJECT|1|IBS_PowerCtrl|Power_RelayCrtl|-1|0|END_OF_OBJECT_SysVar|</dbobject>
              </sink>
              <source>
                <const>1</const>
              </source>
            </assignment>
          </in>
        </set>
        <wait>
          <title>保持断电 OffTime_ms</title>
          <time>
            <value>
              <variable>OffTime_ms</variable>
            </value>
            <unit>ms</unit>
          </time>
        </wait>
        <set>
          <title>IBS 重新上电</title>
          <in>
            <assignment>
              <sink>
                <dbobject>SysVar_BEGIN_OF_OBJECT|1|IBS_PowerCtrl|Power_RelayCrtl|-1|0|END_OF_OBJECT_SysVar|</dbobject>
              </sink>
              <source>
                <const>0</const>
              </source>
            </assignment>
          </in>
        </set>
        <wait>
          <title>等待 1 s</title>
          <time>
            <value>
              <const>1000</const>
            </value>
            <unit>ms</unit>
          </time>
        </wait>
      </function_definition>
      <function_definition navid="7c1d4b60-2a91-4e77-8c55-0d3a6b1f9e21">
        <name>RELAY_SetState</name>
        <export>false</export>
        <description>按调用元组直接写电池/CAB1500/IBS 三路继电器命令并等待 TB_RelaySettle_ms；按需求不设输出关闭或 DVM 电压前置条件，调用方须自行保证动作顺序。</description>
        <parameters>
          <parameter_definition>
            <name>Battery</name>
            <type>int</type>
          </parameter_definition>
          <parameter_definition>
            <name>CAB1500</name>
            <type>int</type>
          </parameter_definition>
          <parameter_definition>
            <name>IBS</name>
            <type>int</type>
          </parameter_definition>
        </parameters>
        <set>
          <title>按元组写三路继电器命令</title>
          <in>
            <assignment>
              <sink>
                <dbobject>SysVar_BEGIN_OF_OBJECT|1|BatteryConnectEquipment|Power_RelayCrtl|-1|0|END_OF_OBJECT_SysVar|</dbobject>
              </sink>
              <source>
                <variable>Battery</variable>
              </source>
            </assignment>
            <assignment>
              <sink>
                <dbobject>SysVar_BEGIN_OF_OBJECT|1|CAB1500_PowerCtrl|Power_RelayCrtl|-1|0|END_OF_OBJECT_SysVar|</dbobject>
              </sink>
              <source>
                <variable>CAB1500</variable>
              </source>
            </assignment>
            <assignment>
              <sink>
                <dbobject>SysVar_BEGIN_OF_OBJECT|1|IBS_PowerCtrl|Power_RelayCrtl|-1|0|END_OF_OBJECT_SysVar|</dbobject>
              </sink>
              <source>
                <variable>IBS</variable>
              </source>
            </assignment>
          </in>
        </set>
        <wait>
          <title>等待继电器稳定</title>
          <time>
            <value>
              <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::TB_RelaySettle_ms|END_OF_OBJECT_ChParScalar|</dbobject>
            </value>
            <unit>ms</unit>
          </time>
        </wait>
      </function_definition>
    </function_definitions>
  </ttlib>
</ttroot>