            <bool>true</bool>
          </await_nextupdate>
          <compare>
            <dbobject>SysVar_BEGIN_OF_OBJECT|1|StaticCurrent_StartNs|IBS_LIN|-1|0|END_OF_OBJECT_SysVar|</dbobject>
            <gt>
              <const>0</const>
            </gt>
          </compare>
        </awaitvaluematch>
        <caplinline>
          <title>计算积分超时与有效时长下限</title>
          <code>IntegrationTimeoutMs = (int)syspar::IBS::WC_IntegrationWindow_ms + 5000;
WindowSeconds = (float)syspar::IBS::WC_IntegrationWindow_ms / 1000.0;
WindowSecondsMin = WindowSeconds - (float)syspar::IBS::WC_TimeTolerance_s;
write("[WORK][WINDOW] window_ms=%d timeout_ms=%d min_s=%.3f",
      (int)syspar::IBS::WC_IntegrationWindow_ms, IntegrationTimeoutMs, WindowSecondsMin);</code>
        </caplinline>
        <awaitvaluematch>
