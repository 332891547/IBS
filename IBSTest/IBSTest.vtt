          <caplinline>
            <title>判定本轮上电功能并标注失败轮次</title>
            <code>int cntNow;
int invNow;

cntNow = (int)@sysvar::LIN::ResetMeasuredCounter;
invNow = (int)@sysvar::LIN::ResetInvalidCounter;

if (cntNow &lt;= CntUpBase)
{
  testStepFail("ResetPowerCycle_Up", "第 %d 次上电失败：有效 Measured_Data 帧未增长 base=%d now=%d", CycleIndex, CntUpBase, cntNow);
}
else if (invNow &gt; InvUpBase)
{
  testStepFail("ResetPowerCycle_Up", "第 %d 次上电失败：无效帧计数增加 base=%d now=%d", CycleIndex, InvUpBase, invNow);
