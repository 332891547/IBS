        <caplinline>
          <title>记录本点结果</title>
          <code>write("[WORK][RESULT] V=%.1f done=%d time=%.3fs sum=%.6fmAs avg=%.6fmA limit=%.3fmA",
      OutPutVoltage, @sysvar::IBS_LIN::StaticCurrent_Done,
