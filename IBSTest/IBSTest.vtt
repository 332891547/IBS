        <caplinline>
          <title>初始化循环序号</title>
          <code>CycleIndex = 1;</code>
        </caplinline>
        <while>
          <title>执行 1000 次上下电循环</title>
          <compare>
            <value>
              <variable>CycleIndex</variable>
            </value>
            <lt>
              <const>1001</const>
            </lt>
          </compare>
          <wait>
