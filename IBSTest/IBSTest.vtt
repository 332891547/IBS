        <caplinline>
          <title>按阈值对 OCV25 表插值并减 0.2 V 得目标电压</title>
          <code>float soc;
float tv;
float loSoc;
float hiSoc;
float loOcv;
float hiOcv;
int i;

soc = Threshold_pct;
loSoc = 0.0;
hiSoc = 100.0;
loOcv = 11.460;
hiOcv = 13.036;

if (soc &gt;= 100.0)
{
  loSoc = 100.0;
  hiSoc = 100.0;
  loOcv = 13.036;
  hiOcv = 13.036;
}
else if (soc &gt;= 90.0)
{
  loSoc = 90.0;
  hiSoc = 100.0;
  loOcv = 12.892;
  hiOcv = 13.036;
}
else if (soc &gt;= 80.0)
{
  loSoc = 80.0;
  hiSoc = 90.0;
  loOcv = 12.755;
  hiOcv = 12.892;
}
else if (soc &gt;= 70.0)
{
  loSoc = 70.0;
  hiSoc = 80.0;
  loOcv = 12.618;
  hiOcv = 12.755;
}
else if (soc &gt;= 60.0)
{
  loSoc = 60.0;
  hiSoc = 70.0;
  loOcv = 12.476;
  hiOcv = 12.618;
}
else if (soc &gt;= 50.0)
{
  loSoc = 50.0;
  hiSoc = 60.0;
  loOcv = 12.329;
  hiOcv = 12.476;
}
else if (soc &gt;= 40.0)
{
  loSoc = 40.0;
  hiSoc = 50.0;
  loOcv = 12.185;
  hiOcv = 12.329;
}
else if (soc &gt;= 30.0)
{
  loSoc = 30.0;
  hiSoc = 40.0;
  loOcv = 12.031;
  hiOcv = 12.185;
}
else if (soc &gt;= 20.0)
{
  loSoc = 20.0;
  hiSoc = 30.0;
  loOcv = 11.869;
  hiOcv = 12.031;
}
else if (soc &gt;= 10.0)
{
  loSoc = 10.0;
  hiSoc = 20.0;
  loOcv = 11.691;
  hiOcv = 11.869;
}
else
{
  loSoc = 0.0;
  hiSoc = 10.0;
  loOcv = 11.460;
  hiOcv = 11.691;
}

if (hiSoc &gt; loSoc)
  tv = loOcv + (soc - loSoc) * (hiOcv - loOcv) / (hiSoc - loSoc);
else
  tv = loOcv;

Target_V = tv - 0.2;
testStepPass("SOCWU_Target", "threshold=%.0f%%, OCV25=%.3f V, target=%.3f V", soc, tv, Target_V);</code>
