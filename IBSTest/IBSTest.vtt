int frames;
int elapsed;
frames = (int)@sysvar::_Statistics::LIN1::Frames;
sampleCount = (int)@sysvar::CAB1500_500::CANMsg_RxCounter;
elapsed = ((int)(timeNowInt64() / 1000000000) - SleepStart_s) * 1000;
if (frames != FramesBase) testStepFail(&quot;SOCWU_Sleep&quot;, &quot;LIN frames grew while stopped: %d -&gt; %d&quot;, FramesBase, frames);
if (sampleCount != RxBase) {
  RxBase = sampleCount;
  Now_mA = @sysvar::CAB1500_500::AnalogCurrent;
  if (HavePrev &amp;&amp; Prev_mA &gt;= 0.0 &amp;&amp; Prev_mA &lt;= 18.0 &amp;&amp; Now_mA &gt;= 0.0 &amp;&amp; Now_mA &lt;= 18.0 &amp;&amp;
     ((Prev_mA &lt;= 4.0 &amp;&amp; Now_mA &gt;= 14.0) || (Prev_mA &gt;= 14.0 &amp;&amp; Now_mA &lt;= 4.0))) {
    SleepDone = 1;
    testStepPass(&quot;SOCWU_Sleep&quot;, &quot;new CAB samples adjacent jump prev=%.3f now=%.3f mA elapsed=%d ms&quot;, Prev_mA, Now_mA, elapsed);
  }
  Prev_mA = Now_mA;
  HavePrev = 1;
}
if (!SleepDone &amp;&amp; elapsed &gt;= 90000) testStepFail(&quot;SOCWU_Sleep&quot;, &quot;no fresh CAB sleep jump in 90 s&quot;);</code></caplinline><wait><title>等待下一次 CAB 电流采样</title><time><value><const>200</const></value><unit>ms</unit></time></wait></while><wait><title>休眠成立后单独再等 5 s</title><time><value><const>5000</const></value><unit>ms</unit></time></wait><caplinline><title>记录自动唤醒统计，仅供诊断</title><code>WakeBase = (int)@sysvar::_Statistics::LIN1::Wakeups; write(&quot;[SOCWU][DIAG] pre-negative automatic wakeups=%d&quot;, WakeBase);</code></caplinline><caplinline><title>200 s 内只接受 LIN 请求事件超时返回 0</title><code>long result;
