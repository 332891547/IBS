      <ts_definition navid="c41d7a02-8f36-4b19-a3d5-6e0b7c2f8a41">
        <name>VoltageAccuracyTest</name>
        <description>电压精度测试：真实电池接入、IBS 接通、CAB1500 断开、电源不输出；同一电池连续 5 组，每组 3 对 IBS 与 DVM 电压，逐组按三次配对相对偏差的最小与最大值判定是否在 ±0.25% 内</description>
        <parameters />
        <variables />
        <preparation>
          <title>准备测试环境</title>
          <ttfunction>
            <title>PHASE_Prepare</title>
            <name>PHASE_Prepare</name>
            <param>
              <type>string</type>
              <value>
                <const>VoltageAccuracyTest</const>
              </value>
            </param>
          </ttfunction>
        </preparation>
        <breakonfail>false</breakonfail>
        <tc>
          <title>切换到电压精度接线：断 CAB1500、接真实电池、电源不输出</title>
          <tcid>c41d7a02-0001-4b19-a3d5-6e0b7c2f8a42</tcid>
          <variables>
            <variable_definition>
              <name>ZeroV</name>
              <type>float</type>
              <source>
                <const>0</const>
              </source>
            </variable_definition>
          </variables>
          <statecheck>
            <title>确认电源输出命令为关闭</title>
            <expected>
              <compare>
                <value>
                  <dbobject>SysVar_BEGIN_OF_OBJECT|1|Set_OutputSts|N8361|-1|0|END_OF_OBJECT_SysVar|</dbobject>
                </value>
                <eq>
                  <const>0</const>
                </eq>
              </compare>
            </expected>
          </statecheck>
          <statecheck>
            <title>确认电池继电器未接入</title>
            <expected>
              <compare>
                <value>
                  <dbobject>SysVar_BEGIN_OF_OBJECT|1|BatteryConnectEquipment|Power_RelayCrtl|-1|0|END_OF_OBJECT_SysVar|</dbobject>
                </value>
                <eq>
                  <const>0</const>
                </eq>
              </compare>
            </expected>
          </statecheck>
          <awaitvaluematch>
            <title>等待 DVM 低于继电器切换阈值</title>
            <timeout>
              <value>
                <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::TB_DvmZeroTimeout_ms|END_OF_OBJECT_ChParScalar|</dbobject>
              </value>
              <unit>ms</unit>
            </timeout>
            <joincondition>
              <enum>all</enum>
            </joincondition>
            <await_nextupdate>
              <bool>true</bool>
            </await_nextupdate>
            <compare>
              <dbobject>SysVar_BEGIN_OF_OBJECT|1|DVM_Voltage|N8361|-1|0|END_OF_OBJECT_SysVar|</dbobject>
              <range>
                <based>
                  <base>
                    <variable>ZeroV</variable>
                  </base>
                  <down_tolerance>
                    <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::TB_MaxSwitchVoltage_V|END_OF_OBJECT_ChParScalar|</dbobject>
                  </down_tolerance>
                  <up_tolerance>
                    <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::TB_MaxSwitchVoltage_V|END_OF_OBJECT_ChParScalar|</dbobject>
                  </up_tolerance>
                </based>
              </range>
            </compare>
          </awaitvaluematch>
          <set>
            <title>电池未接入时断开 CAB1500，保持 IBS 支路接通</title>
            <in>
              <assignment>
                <sink>
                  <dbobject>SysVar_BEGIN_OF_OBJECT|1|CAB1500_PowerCtrl|Power_RelayCrtl|-1|0|END_OF_OBJECT_SysVar|</dbobject>
                </sink>
                <source>
                  <const>1</const>
                </source>
              </assignment>
              <assignment>
                <sink>
                  <dbobject>SysVar_BEGIN_OF_OBJECT|1|IBS_PowerCtrl|Power_RelayCrtl|-1|0|END_OF_OBJECT_SysVar|</dbobject>
                </sink>
                <source>
                  <const>0</const>
                </source>
              </assignment>
            </in>
          </set>
          <set>
            <title>接入真实电池给 IBS 供电</title>
            <in>
              <assignment>
                <sink>
                  <dbobject>SysVar_BEGIN_OF_OBJECT|1|BatteryConnectEquipment|Power_RelayCrtl|-1|0|END_OF_OBJECT_SysVar|</dbobject>
                </sink>
                <source>
                  <const>1</const>
                </source>
              </assignment>
            </in>
          </set>
        </tc>
