  HasPrev = 0;
  SampleCnt = 0;

  write("[SOF][CHG][SEG] round=%d Uout=%.3f V", Round, Uout_V);</code>
              </caplinline>
              <caplfunction>
                <title>充电段：启动 Normal LIN 发送唤醒配置</title>
