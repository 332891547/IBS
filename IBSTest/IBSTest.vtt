              <code>U0_V = @sysvar::N8361::DVM_Voltage;
  Uout_V = U0_V + 2.0;
  if (Uout_V &gt; 14.0) Uout_V = 14.0;

  if (U0_V &gt;= 14.5)
  {
    DirOK = 0;
    testStepFail("SOF_StopLimit", "第 %d 轮 U0=%.3f V 达到 14.5 V 停测上限，提前结束轮次", Round, U0_V);
    Round = 99;
  }
  else if (Uout_V &gt; U0_V &amp;&amp; Round &lt; 6 &amp;&amp; U0_V &gt;= 9.0 &amp;&amp; U0_V &lt;= 14.0)
  {
    DirOK = 1;
  }
  else
  {
    DirOK = 0;
  }

  write("[SOF][CHG][PLAN] round=%d U0=%.3f V Uout=%.3f V dirOK=%d", Round, U0_V, Uout_V, DirOK);</code>
            </caplinline>
            <if>
