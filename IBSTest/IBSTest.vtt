      <function_definition navid="03d96ebf-efe2-40c7-b68e-f8d2c4c49387">
        <name>Restart_IBS</name>
        <export>false</export>
        <description>IBS 断电 OffTime_ms 后重新上电并等待 1 s；断电时长由调用方传入，其他用例仍显式传 6000 ms 保持原行为；复位后预期 SOC_STATE 回到未校准，实际状态由后续 Test Case 判定。</description>
        <parameters>
          <parameter_definition>
            <name>OffTime_ms</name>
            <type>int</type>
          </parameter_definition>
        </parameters>
        <set>
          <title>IBS 断电</title>
          <in>
            <assignment>
              <sink>
                <dbobject>SysVar_BEGIN_OF_OBJECT|1|IBS_PowerCtrl|Power_RelayCrtl|-1|0|END_OF_OBJECT_SysVar|</dbobject>
              </sink>
              <source>
                <const>1</const>
              </source>
            </assignment>
          </in>
        </set>
        <wait>
          <title>保持断电 OffTime_ms</title>
          <time>
            <value>
              <variable>OffTime_ms</variable>
            </value>
            <unit>ms</unit>
          </time>
        </wait>
        <set>
          <title>IBS 重新上电</title>
          <in>
            <assignment>
              <sink>
                <dbobject>SysVar_BEGIN_OF_OBJECT|1|IBS_PowerCtrl|Power_RelayCrtl|-1|0|END_OF_OBJECT_SysVar|</dbobject>
              </sink>
              <source>
                <const>0</const>
              </source>
            </assignment>
          </in>
        </set>
        <wait>
          <title>等待 1 s</title>
          <time>
            <value>
              <const>1000</const>
            </value>
            <unit>ms</unit>
          </time>
        </wait>
      </function_definition>
      <function_definition navid="7c1d4b60-2a91-4e77-8c55-0d3a6b1f9e21">
