          <variable_definition>
            <name>V1_1</name>
            <type>float</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>V1_2</name>
            <type>float</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>V1_3</name>
            <type>float</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>V2_1</name>
