        <caplinline>
          <title>读取 DID 0x1000 并比对 Factor/Offset</title>
          <code>long ret;
long sent;
long waited;
long size;
long copied;
long i;

byte respData[64];
dword bits;

float factor;
float offset;

diagRequest IBS.Voltage_acquisition_calibration_data_Read req;
diagResponse IBS.Voltage_acquisition_calibration_data_Read resp;

diagSetTarget("IBS");
ret = diagSendRequest(req);

if (ret &lt; 0)
{
  testStepFail("DID1000_SEND", "send failed: %d", ret);
}
else
{
  sent = testWaitForDiagRequestSent(req, 2000);
  if (sent != 1)
  {
    testStepFail("DID1000_SEND", "request not sent: %d", sent);
  }
  else
  {
    waited = testWaitForDiagResponse(req, 5000);
    if (waited != 1)
    {
      testStepFail("DID1000_WAIT", "response timeout: %d", waited);
    }
    else
    {
      ret = diagGetLastResponse(req, resp);
      if (ret &lt; 0)
      {
        testStepFail("DID1000_READ", "get response failed: %d", ret);
      }
      else
      {
        size = diagGetPrimitiveSize(resp);
        copied = diagGetPrimitiveData(resp, respData, elcount(respData));
        if (size != 13)
        {
          testStepFail("DID1000_SIZE", "size=%d, expected 13", size);
        }
        else if (copied != size)
        {
          testStepFail("DID1000_READ", "copied %d of %d", copied, size);
        }
        else if (diagIsNegativeResponse(resp))
        {
          testStepFail("DID1000_NRC", "negative response");
        }
        else if (respData[0] != 0x62 || respData[1] != 0x10 || respData[2] != 0x00)
        {
          testStepFail("DID1000_FORMAT", "unexpected header");
        }
        else
        {
          bits = (dword)respData[3] | ((dword)respData[4] &lt;&lt; 8) | ((dword)respData[5] &lt;&lt; 16) | ((dword)respData[6] &lt;&lt; 24);
          factor = interpretAsFloat(bits) / 1000.0;
          bits = (dword)respData[7] | ((dword)respData[8] &lt;&lt; 8) | ((dword)respData[9] &lt;&lt; 16) | ((dword)respData[10] &lt;&lt; 24);
          offset = interpretAsFloat(bits) / 1000.0;

          if ((factor &lt; 0.9995) || (factor &gt; 1.0005))
            testStepFail("DID1000_FACTOR", "Factor=%.6f, expected 1.0", factor);
          else if ((offset &lt; -0.0005) || (offset &gt; 0.0005))
            testStepFail("DID1000_OFFSET", "Offset=%.6f, expected 0", offset);
          else
            testStepPass("DID1000_RESULT", "Factor=%.6f Offset=%.6f", factor, offset);
        }
      }
    }
  }
}</code>
        </caplinline>
        <caplinline>
          <title>读取 DID 0x1001 并比对四个电阻标定字段</title>
          <code>long ret;
long sent;
long waited;
long size;
long copied;
long i;

byte respData[64];
dword bits;

double initial;
double quadratic;
double primary;
double offset;

diagRequest IBS.Resistance_calibration_data_Read req;
diagResponse IBS.Resistance_calibration_data_Read resp;

diagSetTarget("IBS");
ret = diagSendRequest(req);

if (ret &lt; 0)
{
  testStepFail("DID1001_SEND", "send failed: %d", ret);
}
else
{
  sent = testWaitForDiagRequestSent(req, 2000);
  if (sent != 1)
  {
    testStepFail("DID1001_SEND", "request not sent: %d", sent);
  }
  else
  {
    waited = testWaitForDiagResponse(req, 5000);
    if (waited != 1)
    {
      testStepFail("DID1001_WAIT", "response timeout: %d", waited);
    }
    else
    {
      ret = diagGetLastResponse(req, resp);
      if (ret &lt; 0)
      {
        testStepFail("DID1001_READ", "get response failed: %d", ret);
      }
      else
      {
        size = diagGetPrimitiveSize(resp);
        copied = diagGetPrimitiveData(resp, respData, elcount(respData));
        if (size != 21)
        {
          testStepFail("DID1001_SIZE", "size=%d, expected 21", size);
        }
        else if (copied != size)
        {
          testStepFail("DID1001_READ", "copied %d of %d", copied, size);
        }
        else if (diagIsNegativeResponse(resp))
        {
          testStepFail("DID1001_NRC", "negative response");
        }
        else if (respData[0] != 0x62 || respData[1] != 0x10 || respData[2] != 0x01)
        {
          testStepFail("DID1001_FORMAT", "unexpected header");
        }
        else
        {
          bits = (dword)respData[3] | ((dword)respData[4] &lt;&lt; 8) | ((dword)respData[5] &lt;&lt; 16) | ((dword)respData[6] &lt;&lt; 24);
          initial = interpretAsFloat(bits) / 1000000.0;
          bits = (dword)respData[7] | ((dword)respData[8] &lt;&lt; 8) | ((dword)respData[9] &lt;&lt; 16) | ((dword)respData[10] &lt;&lt; 24);
          quadratic = interpretAsFloat(bits) / 1000000.0;
          bits = (dword)respData[11] | ((dword)respData[12] &lt;&lt; 8) | ((dword)respData[13] &lt;&lt; 16) | ((dword)respData[14] &lt;&lt; 24);
          primary = interpretAsFloat(bits) / 1000000.0;
          bits = (dword)respData[15] | ((dword)respData[16] &lt;&lt; 8) | ((dword)respData[17] &lt;&lt; 16) | ((dword)respData[18] &lt;&lt; 24);
          offset = interpretAsFloat(bits) / 1000000.0;

          if ((initial &lt; 149.9995) || (initial &gt; 150.0005))
            testStepFail("DID1001_INITIAL", "Initial=%.9f, expected 150", initial);
          else if ((quadratic &lt; -0.0000004535) || (quadratic &gt; -0.0000004525))
            testStepFail("DID1001_QUADRATIC", "Quadratic=%.12f, expected -0.000000453", quadratic);
          else if ((primary &lt; 0.00010335) || (primary &gt; 0.00010345))
            testStepFail("DID1001_PRIMARY", "Primary=%.12f, expected 0.0001034", primary);
          else if ((offset &lt; 0.997664843) || (offset &gt; 0.997664843))
            testStepFail("DID1001_OFFSET", "Offset=%.12f, expected 0.997664843", offset);
          else
            testStepPass("DID1001_RESULT", "Initial=%.6f Quadratic=%.12f Primary=%.12f Offset=%.12f", initial, quadratic, primary, offset);
        }
      }
    }
  }
}</code>
