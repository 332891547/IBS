          <timeout>
            <value>
              <variable>IntegrationTimeoutMs</variable>
            </value>
            <unit>ms</unit>
          </timeout>
          <joincondition>
            <enum>any</enum>
          </joincondition>
          <await_nextupdate>
            <bool>true</bool>
          </await_nextupdate>
          <compare>
            <dbobject>SysVar_BEGIN_OF_OBJECT|1|StaticCurrent_Done|IBS_LIN|-1|0|END_OF_OBJECT_SysVar|</dbobject>
            <eq>
              <const>1</const>
            </eq>
