        <parameters />
        <breakonfail>true</breakonfail>
        <caplinline>
          <title>判定供电前状态与实测电池电压</title>
          <code>float v;
int bat;
int outSts;
float vMin;
float vMax;

bat    = (int)@sysvar::Power_RelayCrtl::BatteryConnectEquipment;
outSts = (int)@sysvar::N8361::Set_OutputSts;
v      = @sysvar::N8361::DVM_Voltage;
vMin   = (float)syspar::IBS::SOC_BatteryReadyMin_V;
vMax   = (float)syspar::IBS::SOC_BatteryReadyMax_V;

write("[SOC][READY] bat_cmd=%d out_cmd=%d dvm=%.3f V range=%.2f..%.2f V", bat, outSts, v, vMin, vMax);

if (outSts != 0)
  testStepFail("SOC_BatteryReady", "output command is %d, must be 0 before battery supply", outSts);
else if (bat != 1)
  testStepFail("SOC_BatteryReady", "battery relay command is %d, expected 1", bat);
else if (!(v &gt;= vMin &amp;&amp; v &lt;= vMax))
  testStepFail("SOC_BatteryReady", "measured battery voltage %.3f V outside %.2f..%.2f V; do not start charge", v, vMin, vMax);
else
  testStepPass("SOC_BatteryReady", "measured battery voltage %.3f V within %.2f..%.2f V", v, vMin, vMax);</code>
