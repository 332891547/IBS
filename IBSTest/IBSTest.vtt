        <caplinline>
          <title>按重启后温度计算上下限中值电压</title>
          <code>float t;
float lo;
float hi;

t = TBatt_C;
lo = (float)syspar::IBS::SOC_ChartLowAt10C_V;
hi = (float)syspar::IBS::SOC_ChartHigh_V;

if (t &lt;= (float)syspar::IBS::SOC_ChartTempMid1_C)
{
  lo = (float)syspar::IBS::SOC_ChartLowAt10C_V - (float)syspar::IBS::SOC_ChartLowSlope_V_perC * (t - (float)syspar::IBS::SOC_ChartTempMin_C);
  hi = (float)syspar::IBS::SOC_ChartHigh_V;
}
else if (t &lt;= (float)syspar::IBS::SOC_ChartTempMid2_C)
{
  lo = (float)syspar::IBS::SOC_ChartLowFloor_V;
  hi = (float)syspar::IBS::SOC_ChartHigh_V;
}
else
{
  lo = (float)syspar::IBS::SOC_ChartLowFloor_V;
  hi = (float)syspar::IBS::SOC_ChartHigh_V - (float)syspar::IBS::SOC_ChartHighSlope_V_perC * (t - (float)syspar::IBS::SOC_ChartTempMid2_C);
}

Vcal_V = (lo + hi) / 2.0;
VcalFirst_V = Vcal_V;
testStepPass("SOCWU_HoldVcal", "T=%.1f C, band %.3f..%.3f V, midpoint %.3f V", t, lo, hi, Vcal_V);</code>
