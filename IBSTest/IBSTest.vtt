        <tc>
          <title>正常结束后断开真实电池</title>
          <tcid>ae576d60-2c1a-4fa9-a599-b0b88ae1cff0</tcid>
          <set>
            <title>正常结束后断开真实电池</title>
            <in>
              <assignment>
                <sink>
                  <dbobject>SysVar_BEGIN_OF_OBJECT|1|BatteryConnectEquipment|Power_RelayCrtl|-1|0|END_OF_OBJECT_SysVar|</dbobject>
                </sink>
                <source>
                  <const>0</const>
                </source>
              </assignment>
            </in>
          </set>
        </tc>
        <completion>
          <title>完成测试并恢复安全态</title>
          <ttfunction>
            <title>PHASE_Complete</title>
            <name>PHASE_Complete</name>
          </ttfunction>
        </completion>
      </ts_definition>
    </ts_definitions>
    <tc_definitions>
      <tc_definition>
        <name>SleepCurrent</name>
        <description>单个电压点的休眠平均电流：每点 3 轮，每轮关输出、设压限流、开输出、等到压、LIN 通讯 60 s、监控 10 s（三帧有效性）、停 LIN、静置 60 s、连续积分 20 min 并判定平均电流小于 0.250 mA。</description>
        <tcid>b7c1a2d3-0000-4a01-9b01-000000000000</tcid>
        <parameters>
          <parameter_definition>
            <name>OutPutVoltage</name>
            <type>float</type>
          </parameter_definition>
        </parameters>
        <variables>
          <variable_definition>
            <name>Repeat</name>
            <type>int</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>WindowSeconds</name>
            <type>float</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
          <variable_definition>
            <name>IntegrationTimeoutMs</name>
            <type>int</type>
            <source>
              <const>0</const>
            </source>
          </variable_definition>
        </variables>
        <breakonfail>false</breakonfail>
        <caplinline>
          <title>初始化轮次并记录本点开始</title>
          <code>Repeat = 0;
write("[SLEEP][POINT][BEGIN] V=%.1f repeats=%d t=%I64d", OutPutVoltage, (int)syspar::IBS::SC_Repeats, timeNowInt64());</code>
        </caplinline>
        <while>
          <title>每点按 SC_Repeats 轮执行</title>
          <compare>
            <value>
              <variable>Repeat</variable>
            </value>
            <lt>
              <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::SC_Repeats|END_OF_OBJECT_ChParScalar|</dbobject>
            </lt>
          </compare>
          <caplinline>
            <title>轮次加一</title>
            <code>Repeat = Repeat + 1;</code>
          </caplinline>
          <caplfunction>
            <title>设定电压与充放电限流 0.5 A</title>
            <name>PWR_Configure_Check</name>
            <param>
              <type>float</type>
              <value>
                <variable>OutPutVoltage</variable>
              </value>
            </param>
            <param>
              <type>float</type>
              <value>
                <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::SC_ChargeLimit_A|END_OF_OBJECT_ChParScalar|</dbobject>
              </value>
            </param>
            <param>
              <type>float</type>
              <value>
                <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::SC_DischargeLimit_A|END_OF_OBJECT_ChParScalar|</dbobject>
              </value>
            </param>
          </caplfunction>
          <caplfunction>
            <title>开启电源输出</title>
            <name>PWR_On_Check</name>
          </caplfunction>
          <awaitvaluematch>
            <title>等待 DVM 到达目标电压容差范围</title>
            <timeout>
              <value>
                <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::SC_VoltageTimeout_ms|END_OF_OBJECT_ChParScalar|</dbobject>
              </value>
              <unit>ms</unit>
            </timeout>
            <joincondition>
              <enum>all</enum>
            </joincondition>
            <await_nextupdate>
              <bool>true</bool>
            </await_nextupdate>
            <compare>
              <dbobject>SysVar_BEGIN_OF_OBJECT|1|DVM_Voltage|N8361|-1|0|END_OF_OBJECT_SysVar|</dbobject>
              <range>
                <based>
                  <base>
                    <variable>OutPutVoltage</variable>
                  </base>
                  <down_tolerance>
                    <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::SC_VoltageTolerance_V|END_OF_OBJECT_ChParScalar|</dbobject>
                  </down_tolerance>
                  <up_tolerance>
                    <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::SC_VoltageTolerance_V|END_OF_OBJECT_ChParScalar|</dbobject>
                  </up_tolerance>
                </based>
              </range>
            </compare>
          </awaitvaluematch>
          <caplfunction>
            <title>开启 LIN Normal 调度并等首帧</title>
            <name>LIN_OpenNormal_Check</name>
          </caplfunction>
          <wait>
            <title>保持 LIN 通讯（SC_LinRun_ms）</title>
            <time>
              <value>
                <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::SC_LinRun_ms|END_OF_OBJECT_ChParScalar|</dbobject>
              </value>
              <unit>ms</unit>
            </time>
          </wait>
          <caplfunction>
            <title>监控 10 s：三帧有效性判定</title>
            <name>SleepCurrent_Monitor_Check</name>
          </caplfunction>
          <caplfunction>
            <title>停止 LIN 调度</title>
            <name>LIN_Stop_Check</name>
          </caplfunction>
          <wait>
            <title>停 LIN 后静置（SC_SleepWait_ms）</title>
            <time>
              <value>
                <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::SC_SleepWait_ms|END_OF_OBJECT_ChParScalar|</dbobject>
              </value>
              <unit>ms</unit>
            </time>
          </wait>
          <set>
            <title>写入积分窗口并清零积分状态</title>
            <in>
              <assignment>
                <sink>
                  <dbobject>SysVar_BEGIN_OF_OBJECT|1|StaticCurrent_Window_ms|IBS_LIN|-1|0|END_OF_OBJECT_SysVar|</dbobject>
                </sink>
                <source>
                  <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::SC_IntegrationWindow_ms|END_OF_OBJECT_ChParScalar|</dbobject>
                </source>
              </assignment>
              <assignment>
                <sink>
                  <dbobject>SysVar_BEGIN_OF_OBJECT|1|StaticCurrent_Clear|IBS_LIN|-1|0|END_OF_OBJECT_SysVar|</dbobject>
                </sink>
                <source>
                  <const>0</const>
                </source>
              </assignment>
              <assignment>
                <sink>
                  <dbobject>SysVar_BEGIN_OF_OBJECT|1|StaticCurrent_Done|IBS_LIN|-1|0|END_OF_OBJECT_SysVar|</dbobject>
                </sink>
                <source>
                  <const>0</const>
                </source>
              </assignment>
              <assignment>
                <sink>
                  <dbobject>SysVar_BEGIN_OF_OBJECT|1|StaticCurrent_StartNs|IBS_LIN|-1|0|END_OF_OBJECT_SysVar|</dbobject>
                </sink>
                <source>
                  <const>0</const>
                </source>
              </assignment>
            </in>
          </set>
          <wait>
            <title>清零释放后等待 20 ms</title>
            <time>
              <value>
                <const>20</const>
              </value>
              <unit>ms</unit>
            </time>
          </wait>
          <set>
            <title>触发积分窗口</title>
            <in>
              <assignment>
                <sink>
                  <dbobject>SysVar_BEGIN_OF_OBJECT|1|StaticCurrent_Clear|IBS_LIN|-1|0|END_OF_OBJECT_SysVar|</dbobject>
                </sink>
                <source>
                  <const>1</const>
                </source>
              </assignment>
            </in>
          </set>
          <awaitvaluematch>
            <title>确认积分窗口已启动</title>
            <timeout>
              <value>
                <const>2000</const>
              </value>
              <unit>ms</unit>
            </timeout>
            <joincondition>
              <enum>any</enum>
            </joincondition>
            <await_nextupdate>
              <bool>true</bool>
            </await_nextupdate>
            <compare>
              <dbobject>SysVar_BEGIN_OF_OBJECT|1|StaticCurrent_StartNs|IBS_LIN|-1|0|END_OF_OBJECT_SysVar|</dbobject>
              <gt>
                <const>0</const>
              </gt>
            </compare>
          </awaitvaluematch>
          <caplinline>
            <title>计算积分超时（窗口 + 5 s 余量）</title>
            <code>IntegrationTimeoutMs = (int)syspar::IBS::SC_IntegrationWindow_ms + 5000;
WindowSeconds = (float)syspar::IBS::SC_IntegrationWindow_ms / 1000.0;
write("[SLEEP][TIMEOUT] window_ms=%d timeout_ms=%d", (int)syspar::IBS::SC_IntegrationWindow_ms, IntegrationTimeoutMs);</code>
          </caplinline>
          <awaitvaluematch>
            <title>等待积分完成（窗口时长 + 5 s）</title>
            <timeout>
