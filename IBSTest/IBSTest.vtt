    <tg navid="c2a6a817-8e8d-4a2b-a997-af9218ad549a">
      <title>canoe 用法测试</title>
      <tc>
        <title>取参数文件变量和结构体</title>
        <tcid>9d2796b1-a9d8-47cd-95f5-22cc89202638</tcid>
        <caplinline>
          <title>标量参数：两级路径</title>
          <code>long waitMs;
float zeroTol;

waitMs  = (long)syspar::IBS::TB_DvmZeroTimeout_ms;
zeroTol = (float)syspar::IBS::TB_DvmZeroTolerance_V;

write("[PARAM][L2] wait_ms=%ld zero_tol=%.2f", waitMs, zeroTol);</code>
        </caplinline>
        <caplinline>
          <title>结构体成员：两级路径</title>
          <code>long rBattery;
long rCAB1500;
long rIBS;

rBattery = (long)syspar::IBS::RelayIdle.Battery;
rCAB1500 = (long)syspar::IBS::RelayIdle.CAB1500;
rIBS     = (long)syspar::IBS::RelayIdle.IBS;

write("[PARAM][STRUCT] RelayIdle = %d / %d / %d", rBattery, rCAB1500, rIBS);</code>
        </caplinline>
        <caplinline>
          <title>只读检查 IDLE 参数，禁止示例直接切继电器</title>
          <code>if ((int)syspar::IBS::RelayIdle.Battery != 0 ||
    (int)syspar::IBS::RelayIdle.CAB1500 != 1 ||
    (int)syspar::IBS::RelayIdle.IBS != 0)
  testStepFail("RelayIdleParam", "IDLE parameter tuple is not the bench-confirmed 0/1/0");</code>
        </caplinline>
      </tc>
      <tc>
        <title>切换调度表</title>
        <tcid>82ab3bd7-101a-4c7d-b8c2-b91d49aba81d</tcid>
        <preparation>
          <title />
          <caplfunction>
            <title />
            <name>SNAP_WakeNode</name>
            <param>
              <type>int</type>
              <value>
                <const>0</const>
              </value>
            </param>
          </caplfunction>
          <set>
            <title />
            <in>
              <assignment>
                <sink>
                  <dbobject>SysVar_BEGIN_OF_OBJECT|1|Set_OutputSts|N8361|-1|0|END_OF_OBJECT_SysVar|</dbobject>
                </sink>
                <source>
                  <const>0</const>
                </source>
              </assignment>
            </in>
          </set>
          <wait>
            <title />
            <time>
              <value>
                <const>100</const>
              </value>
              <unit>ms</unit>
            </time>
          </wait>
        </preparation>
        <set>
          <title />
          <in>
            <assignment>
              <sink>
                <dbobject>SysVar_BEGIN_OF_OBJECT|1|Set_OutputSts|N8361|-1|0|END_OF_OBJECT_SysVar|</dbobject>
              </sink>
              <source>
                <const>1</const>
              </source>
            </assignment>
          </in>
        </set>
        <linchangeschedtable>
          <title />
          <table_index>
            <const>2</const>
          </table_index>
          <network>Network_BEGIN_OF_OBJECT|1|LIN|5|1|END_OF_OBJECT_Network|</network>
        </linchangeschedtable>
        <linstartscheduler>
          <title />
          <network>Network_BEGIN_OF_OBJECT|1|LIN|5|1|END_OF_OBJECT_Network|</network>
        </linstartscheduler>
        <caplinline>
          <title />
          <code>
/*==================================================
 * IBS DID 0x1000 电压校准数据读取
 *
 * ECU : IBS
 * SID : 0x22
 * DID : 0x1000
 * Data:
 *   Factor     4 Byte Float
 *   Offset     4 Byte Float
 *   VoltageCRC 2 Byte
 *==================================================*/

long ret;
long sent;
long waited;
long size;
long copied;
long i;

byte respData[64];

dword bits;

float factor;
float offset;

long crcValue;

diagRequest IBS.Voltage_acquisition_calibration_data_Read req;
diagResponse IBS.Voltage_acquisition_calibration_data_Read resp;


/*========== 1. 设置诊断目标 ==========*/

diagSetTarget("IBS");


/*========== 2. 发送诊断请求 ==========*/

ret = diagSendRequest(req);

if (ret &lt; 0)
{
  testStepFail("DID1000_SEND",
               "Diagnostic request send failed: %d", ret);
}
else
{
  /*========== 3. 等待请求发送完成 ==========*/

  sent = testWaitForDiagRequestSent(req, 2000);

  if (sent != 1)
  {
    testStepFail("DID1000_SEND",
                 "Request not sent: %d", sent);
  }
  else
  {
    /*========== 4. 等待诊断响应 ==========*/

    waited = testWaitForDiagResponse(req, 5000);

    if (waited != 1)
    {
      testStepFail("DID1000_WAIT",
                   "Diagnostic response timeout: %d", waited);
    }
    else
    {
      /*========== 5. 获取诊断响应 ==========*/

      ret = diagGetLastResponse(req, resp);

      if (ret &lt; 0)
      {
        testStepFail("DID1000_READ",
                     "Get response failed: %d", ret);
      }
      else
      {
        size = diagGetPrimitiveSize(resp);

        if (size &lt;= 0 || size &gt; elcount(respData))
        {
          testStepFail("DID1000_SIZE",
                       "Invalid response size: %d", size);
        }
        else
        {
          copied = diagGetPrimitiveData(
                     resp,
                     respData,
                     elcount(respData));

          if (copied != size)
          {
            testStepFail("DID1000_READ",
                         "Data copy failed: %d / %d",
                         copied, size);
          }
          else
          {
            /*========== 6. 输出原始响应 ==========*/

            write("========== DID 0x1000 RAW ==========");
            write("Response size: %d", size);

            for (i = 0; i &lt; size; i++)
            {
              write("RAW[%d] = 0x%02X",
                    i, respData[i]);
            }

            /*========== 7. 检查否定响应 ==========*/

            if (diagIsNegativeResponse(resp))
            {
              testStepFail("DID1000_NRC",
                           "Negative diagnostic response");
            }
            else if (size != 13 ||
                     respData[0] != 0x62 ||
                     respData[1] != 0x10 ||
                     respData[2] != 0x00)
            {
              testStepFail("DID1000_FORMAT",
                           "Invalid response format, size=%d",
                           size);
            }
            else
            {
              /*========== 8. 解析 Factor ==========*/

              bits = (dword)respData[3]
                   | ((dword)respData[4] &lt;&lt; 8)
                   | ((dword)respData[5] &lt;&lt; 16)
                   | ((dword)respData[6] &lt;&lt; 24);

              factor = interpretAsFloat(bits) / 1000.0;

              /*========== 9. 解析 Offset ==========*/

              bits = (dword)respData[7]
                   | ((dword)respData[8] &lt;&lt; 8)
                   | ((dword)respData[9] &lt;&lt; 16)
                   | ((dword)respData[10] &lt;&lt; 24);

              offset = interpretAsFloat(bits) / 1000.0;

              /*========== 10. 解析 VoltageCRC ==========*/

              crcValue = (long)respData[11]
                       | ((long)respData[12] &lt;&lt; 8);

              /*========== 11. 输出解析结果 ==========*/

              write("========== DID 0x1000 DECODE ==========");

              write("Factor HEX: 0x%08X", 
                    (dword)respData[3]
                    | ((dword)respData[4] &lt;&lt; 8)
                    | ((dword)respData[5] &lt;&lt; 16)
                    | ((dword)respData[6] &lt;&lt; 24));

              write("Factor = %f", factor);
              write("Offset = %f", offset);
              write("VoltageCRC = 0x%04X", crcValue);

              testStepPass("DID1000_READ",
                           "Factor=%f, Offset=%f, CRC=0x%04X",
                           factor, offset, crcValue);
            }
          }
        }
      }
    }
  }
}
</code>
        </caplinline>
        <completion>
          <title />
          <linstopscheduler>
            <title />
            <network>Network_BEGIN_OF_OBJECT|1|LIN|5|1|END_OF_OBJECT_Network|</network>
          </linstopscheduler>
