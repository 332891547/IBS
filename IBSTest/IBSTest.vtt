          <code>V1_1 = @sysvar::LIN::ResetUBattV;
V2_1 = @sysvar::N8361::DVM_Voltage;
Cnt1 = @sysvar::LIN::ResetMeasuredCounter;
write("[VA][SAMPLE] group=%d n=%d V1=%.4f V2=%.4f cnt=%d",
