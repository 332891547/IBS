          <in>
            <assignment>
              <sink>
                <dbobject>SysVar_BEGIN_OF_OBJECT|1|Set_OutputSts|N8361|-1|0|END_OF_OBJECT_SysVar|</dbobject>
              </sink>
              <source>
                <const>1</const>
              </source>
            </assignment>
          </in>
