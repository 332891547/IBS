            <compare>
              <dbobject>SysVar_BEGIN_OF_OBJECT|1|DVM_Voltage|N8361|-1|0|END_OF_OBJECT_SysVar|</dbobject>
              <range>
                <based>
                  <base>
                    <variable>TargetVoltage</variable>
                  </base>
                  <down_tolerance>
                    <variable>VoltageTolerance_V</variable>
                  </down_tolerance>
                  <up_tolerance>
                    <variable>VoltageTolerance_V</variable>
                  </up_tolerance>
                </based>
              </range>
            </compare>
          </awaitvaluematch>
          <caplfunction>
            <title>本档保持并逐段监控 5 min</title>
