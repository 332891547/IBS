      (int)GroupIndex, 2, V1_2, V2_2, Cnt2);</code>
        </caplinline>
        <wait>
          <title>第 3 次采样前等待 VA_SampleInterval_ms</title>
          <time>
            <value>
              <dbobject>ChParScalar_BEGIN_OF_OBJECT|1|IBS::VA_SampleInterval_ms|END_OF_OBJECT_ChParScalar|</dbobject>
            </value>
            <unit>ms</unit>
          </time>
        </wait>
        <caplinline>
          <title>第 3 次：锁存 IBS 电压与 DVM 电压</title>
          <code>V1_3 = @sysvar::LIN::ResetUBattV;
V2_3 = @sysvar::N8361::DVM_Voltage;
Cnt3 = @sysvar::LIN::ResetMeasuredCounter;
InvNow = @sysvar::LIN::ResetInvalidCounter;
write("[VA][SAMPLE] group=%d n=%d V1=%.4f V2=%.4f cnt=%d",
      (int)GroupIndex, 3, V1_3, V2_3, Cnt3);</code>
        </caplinline>
        <caplinline>
          <title>计算 3 次配对偏差并判定本组 ±VA_TolerancePct</title>
          <code>float tol;
float absE1;
float absE2;
float absE3;
float eMin;
float eMax;
float avgV1;
float avgV2;

tol = (float)syspar::IBS::VA_TolerancePct;
Bad = 0;
eMin = 0.0;
eMax = 0.0;
avgV1 = 0.0;
avgV2 = 0.0;
absE1 = 0.0;
absE2 = 0.0;
absE3 = 0.0;

/* 数据有效性：V2 不得为 0，三次之间必须各有新有效 Measured_Data 帧，无效信号不得增加 */
if (V2_1 == 0.0 || V2_2 == 0.0 || V2_3 == 0.0)
  Bad = 2;
else if (Cnt1 &lt;= Cnt0 || Cnt2 &lt;= Cnt1 || Cnt3 &lt;= Cnt2)
  Bad = 3;
else if (InvNow != Inv0)
  Bad = 4;

if (Bad == 0)
{
  /* 逐次配对相对偏差，% */
  E1 = (V1_1 - V2_1) / V2_1 * 100.0;
  E2 = (V1_2 - V2_2) / V2_2 * 100.0;
  E3 = (V1_3 - V2_3) / V2_3 * 100.0;

  eMin = E1;
  if (E2 &lt; eMin) eMin = E2;
  if (E3 &lt; eMin) eMin = E3;
  eMax = E1;
  if (E2 &gt; eMax) eMax = E2;
  if (E3 &gt; eMax) eMax = E3;

  avgV1 = (V1_1 + V1_2 + V1_3) / 3.0;
  avgV2 = (V2_1 + V2_2 + V2_3) / 3.0;

  write("[VA][GROUP][RESULT] group=%d E1=%.4f E2=%.4f E3=%.4f Emin=%.4f Emax=%.4f avgV1=%.4f avgV2=%.4f tol=%.4f",
        (int)GroupIndex, E1, E2, E3, eMin, eMax, avgV1, avgV2, tol);
}

/* 逐组判定：三项均有效且三次偏差全部落在 +/-tol 内 */
if (Bad == 2)
  testStepFail("VA_GroupInvalid", "group %d: DVM voltage is 0 V, no valid V2", (int)GroupIndex);
else if (Bad == 3)
  testStepFail("VA_GroupInvalid", "group %d: no new valid Measured_Data frame between samples (cnt %d/%d/%d/%d)",
               (int)GroupIndex, Cnt0, Cnt1, Cnt2, Cnt3);
else if (Bad == 4)
  testStepFail("VA_GroupInvalid", "group %d: invalid business signal increased %d -&gt; %d",
               (int)GroupIndex, Inv0, InvNow);
else
{
  absE1 = (E1 &lt; 0.0) ? -E1 : E1;
  absE2 = (E2 &lt; 0.0) ? -E2 : E2;
  absE3 = (E3 &lt; 0.0) ? -E3 : E3;
  if (absE1 &lt;= tol &amp;&amp; absE2 &lt;= tol &amp;&amp; absE3 &lt;= tol)
    testStepPass("VA_GroupPass", "group %d: E1=%.4f%% E2=%.4f%% E3=%.4f%% within +/-%.4f%%",
                 (int)GroupIndex, E1, E2, E3, tol);
  else
    testStepFail("VA_GroupFail", "group %d: E1=%.4f%% E2=%.4f%% E3=%.4f%% exceeds +/-%.4f%%",
                 (int)GroupIndex, E1, E2, E3, tol);
}</code>
        </caplinline>
      </tc_definition>
