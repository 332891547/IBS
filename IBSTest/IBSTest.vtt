          </await_nextupdate>
          <compare>
            <dbobject>DBSignal_BEGIN_OF_OBJECT|1|NodeOrFrameData_BEGIN_OF_OBJECT|1|5|LIN|1|MAXUS_LIN_V3|IBS|END_OF_OBJECT_NodeOrFrameData|FrameData_BEGIN_OF_OBJECT|1|255|255|0|0|Calc_Data_1|53|False|END_OF_OBJECT_FrameData|SOC|1|END_OF_OBJECT_|</dbobject>
